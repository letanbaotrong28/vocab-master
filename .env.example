# VocabMaster Server & App Environment Configuration Example

# Backend Server Port
PORT=5000

# Required: a private random secret of at least 32 bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_private_random_secret_of_at_least_32_bytes

# Allowed CORS Origin Whitelist for Frontend Access (comma-separated when needed)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Cloud PostgreSQL Database URL (Leave empty to use local SQLite database.db)
# Example: postgres://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: require valid TLS certificates for PostgreSQL (set false only for a trusted local/self-signed server)
PGSSL_STRICT=true

# Optional: override the local SQLite path (mainly useful for isolated tests/deployments)
SQLITE_DB_PATH=

# Optional Express JSON/form payload limit. The default is 10mb.
REQUEST_BODY_LIMIT=10mb

# Trusted reverse-proxy networks used for HTTPS/IP detection and rate limiting.
# Use provider-documented CIDRs when its proxy is not on a private network.
TRUST_PROXY=loopback,linklocal,uniquelocal

# Frontend Vite API Server Base URL (Leave empty for local development proxy / relative requests)
# Example: https://vocab-master-ve5d.onrender.com
VITE_API_URL=
